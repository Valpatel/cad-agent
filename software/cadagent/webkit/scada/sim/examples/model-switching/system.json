{
  "format": "scada-system",
  "version": 1,
  "system": {
    "id": "pump-equation-bench",
    "label": "Pump equation bench",
    "description": "Two focused views of one explicitly bounded pump experiment."
  },
  "components": [
    {
      "id": "source",
      "type": "tank",
      "label": "Supply boundary",
      "ports": [
        {
          "id": "outlet",
          "side": "right",
          "offset": 0.5
        }
      ],
      "provenance": [
        "assumed"
      ]
    },
    {
      "id": "pump",
      "type": "pump",
      "label": "Variable-speed pump",
      "ports": [
        {
          "id": "inlet",
          "side": "left",
          "offset": 0.5
        },
        {
          "id": "outlet",
          "side": "right",
          "offset": 0.5
        },
        {
          "id": "drive",
          "side": "bottom",
          "offset": 0.5
        }
      ],
      "provenance": [
        "assumed"
      ]
    },
    {
      "id": "valve",
      "type": "control-valve",
      "label": "Delivery restriction",
      "ports": [
        {
          "id": "inlet",
          "side": "left",
          "offset": 0.5
        },
        {
          "id": "outlet",
          "side": "right",
          "offset": 0.5
        }
      ],
      "provenance": [
        "assumed"
      ]
    },
    {
      "id": "sink",
      "type": "tank",
      "label": "Delivery boundary",
      "ports": [
        {
          "id": "inlet",
          "side": "left",
          "offset": 0.5
        }
      ],
      "provenance": [
        "assumed"
      ]
    },
    {
      "id": "power",
      "type": "transformer",
      "label": "Electrical boundary",
      "ports": [
        {
          "id": "secondary",
          "side": "left",
          "offset": 0.5
        }
      ],
      "provenance": [
        "assumed"
      ]
    }
  ],
  "connections": [
    {
      "id": "intake",
      "from": {
        "component": "source",
        "port": "outlet"
      },
      "to": {
        "component": "pump",
        "port": "inlet"
      },
      "medium": "liquid",
      "flowBinding": "/flows/intake"
    },
    {
      "id": "delivery",
      "from": {
        "component": "pump",
        "port": "outlet"
      },
      "to": {
        "component": "valve",
        "port": "inlet"
      },
      "medium": "liquid",
      "flowBinding": "/flows/delivery"
    },
    {
      "id": "outlet",
      "from": {
        "component": "valve",
        "port": "outlet"
      },
      "to": {
        "component": "sink",
        "port": "inlet"
      },
      "medium": "liquid",
      "flowBinding": "/flows/outlet"
    },
    {
      "id": "supply",
      "from": {
        "component": "power",
        "port": "secondary"
      },
      "to": {
        "component": "pump",
        "port": "drive"
      },
      "medium": "electricity",
      "flowBinding": "/flows/supply"
    }
  ],
  "views": [
    {
      "id": "hydraulics",
      "label": "Hydraulic path",
      "canvas": {
        "width": 1080,
        "height": 350
      },
      "placements": [
        {
          "component": "source",
          "x": 30,
          "y": 80,
          "width": 205,
          "height": 190
        },
        {
          "component": "pump",
          "x": 300,
          "y": 80,
          "width": 205,
          "height": 190
        },
        {
          "component": "valve",
          "x": 570,
          "y": 80,
          "width": 205,
          "height": 190
        },
        {
          "component": "sink",
          "x": 840,
          "y": 80,
          "width": 205,
          "height": 190
        }
      ],
      "routes": [
        {
          "connection": "intake",
          "points": [
            {
              "x": 235,
              "y": 175
            },
            {
              "x": 300,
              "y": 175
