            },
            {
              "x": 195,
              "y": 320
            },
            {
              "x": 195,
              "y": 270
            }
          ]
        }
      ]
    }
  ],
  "commands": [
    {
      "id": "sourceEnable",
      "label": "Equipment enable",
      "component": "source",
      "action": "setEnabled",
      "arguments": {
        "equipment": "source"
      }
    },
    {
      "id": "pumpEnable",
      "label": "Equipment enable",
      "component": "pump",
      "action": "setEnabled",
      "arguments": {
        "equipment": "pump"
      }
    },
    {
      "id": "valveEnable",
      "label": "Equipment enable",
      "component": "valve",
      "action": "setEnabled",
      "arguments": {
        "equipment": "valve"
      }
    },
    {
      "id": "powerEnable",
      "label": "Equipment enable",
      "component": "power",
      "action": "setEnabled",
      "arguments": {
        "equipment": "power"
      }
    },
    {
      "id": "pumpLoad",
      "label": "Speed command (%)",
      "component": "pump",
      "action": "setLoad",
      "arguments": {
        "equipment": "pump"
      }
    },
    {
      "id": "valveLoad",
      "label": "Allocation opening (%)",
      "component": "valve",
      "action": "setLoad",
      "arguments": {
        "equipment": "valve"
      }
    },
    {
      "id": "valveOpen",
      "label": "Open delivery valve",
      "component": "valve",
      "action": "setOpen",
      "arguments": {
        "equipment": "valve"
      }
    },
    {
      "id": "pumpsetFault",
      "label": "Inject pump fault",
      "component": "pump",
      "action": "setFault",
      "arguments": {
        "equipment": "pump",
        "value": true
      }
    },
    {
      "id": "pumprepair",
      "label": "Repair pump",
      "component": "pump",
      "action": "repair",
      "arguments": {
        "equipment": "pump"
      }
    }
  ],
  "controls": [
    {
      "id": "sourceEnable",
      "label": "Enabled",
      "component": "source",
      "command": "sourceEnable",
      "kind": "toggle",
      "binding": "/controls/source/enabled"
    },
    {
      "id": "pumpEnable",
      "label": "Enabled",
      "component": "pump",
      "command": "pumpEnable",
      "kind": "toggle",
      "binding": "/controls/pump/enabled"
    },
    {
      "id": "valveEnable",
      "label": "Enabled",
      "component": "valve",
      "command": "valveEnable",
      "kind": "toggle",
      "binding": "/controls/valve/enabled"
    },
    {
      "id": "powerEnable",
      "label": "Enabled",
      "component": "power",
      "command": "powerEnable",
      "kind": "toggle",
      "binding": "/controls/power/enabled"
    },
    {
      "id": "pumpLoad",
      "label": "Speed command (%)",
      "component": "pump",
      "command": "pumpLoad",
      "kind": "range",
      "binding": "/controls/pump/load",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "valveLoad",
      "label": "Allocation opening (%)",
      "component": "valve",
      "command": "valveLoad",
      "kind": "range",
      "binding": "/controls/valve/load",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "valveOpen",
      "label": "Valve open",
      "component": "valve",
      "command": "valveOpen",
      "kind": "toggle",
      "binding": "/controls/valve/open"
    },
    {
      "id": "pumpsetFault",
      "label": "Inject pump fault",
      "component": "pump",
      "command": "pumpsetFault",
      "kind": "button"
    },
    {
      "id": "pumprepair",
      "label": "Repair pump",
      "component": "pump",
      "command": "pumprepair",
      "kind": "button"
    }
  ],
  "provenance": [
    {
      "id": "assumed",
      "label": "Editable demonstration assumptions",
      "kind": "illustrative",
      "description": "Assumed water properties, curve coefficients, normalized allocation bridges and diagram layout. No plant data or field validation."
    }
  ],
  "assumptions": [
    {
      "id": "local",
      "label": "Equation boundary",
      "value": "One local SI curve solve; shared allocation kernel is normalized. No full pressure network, calibration, cavitation or surge model.",
      "provenance": "assumed"
    }
  ]
}
