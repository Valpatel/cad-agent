            {
              "x": 775,
              "y": 175
            },
            {
              "x": 840,
              "y": 175
            }
          ]
        }
      ]
    },
    {
      "id": "drive",
      "label": "Drive & pump",
      "canvas": {
        "width": 850,
        "height": 370
      },
      "placements": [
        {
          "component": "pump",
          "x": 80,
          "y": 65,
          "width": 230,
          "height": 205
        },
        {
          "component": "power",
          "x": 540,
          "y": 65,
          "width": 230,
          "height": 205
        }
      ],
      "routes": [
        {
          "connection": "supply",
          "points": [
            {
              "x": 540,
              "y": 167.5
            },
            {
              "x": 425,
              "y": 167.5
            },
            {
              "x": 425,
