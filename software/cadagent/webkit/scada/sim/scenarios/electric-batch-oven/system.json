    {
      "id": "assumed-model",
      "label": "Editable normalized model guesses",
      "kind": "assumed",
      "description": "Every power limit, inventory, heat store, loss and damage response is a toy assumption. No calibrated temperature, recipe, process-quality or safety prediction."
    },
    {
      "id": "authored-layout",
      "label": "Original illustrative cell layout",
      "kind": "illustrative",
      "description": "Coordinates, equipment selection and connections are authored examples, not a verified facility drawing."
    },
