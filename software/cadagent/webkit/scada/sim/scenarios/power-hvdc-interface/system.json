  "provenance": [
    {
      "id": "assumed-model",
      "label": "Editable normalized model guesses",
      "kind": "assumed",
      "description": "Every capacity, inventory, thermal index, loss, response and incident coefficient is an authoring choice, not validated by the references."
    },
    {
      "id": "authored-layout",
      "label": "Illustrative plant routing and layout",
      "kind": "illustrative",
      "description": "Coordinates, asset tags, selected concept composition and simplified connections are editable authored diagrams, not a verified P&ID or electrical design."
    },
    {
      "id": "P09",
      "label": "P09 \u00b7 structural reference",
      "kind": "external",
      "source": "OSHA, [Illustrated Glossary: Substations](https://www.osha.gov/etools/electric-power/illustrated-glossary/sub-station), glossary identified as February 2004",
      "description": "Types, functions and equipment list | Supports: Separate generator step-up, transmission step-down, distribution and underground arrangements. A substation is a composition of equipment, not merely a transformer icon. | Reviewed 2026-11-13. Does not validate toy parameters."
    },
    {
      "id": "P10",
      "label": "P10 \u00b7 structural reference",
      "kind": "external",
      "source": "OSHA, [Electric Power Glossary of Terms](https://www.osha.gov/etools/electric-power/glossary-terms), no individual revision date shown",
      "description": "Entries for current transformers, disconnects, capacitor banks, converters, control houses, protective equipment, switchgear and synchronous condensers | Supports: Measurement, switching, surge protection, reactive support and conversion need distinct categories/ports. Illustrations support recognizable disconnect and switchgear silhouettes. This is a naming reference, not a protection-coordination design. | Reviewed 2026-11-13. Does not validate toy parameters."
    }
  ],
  "assumptions": [
    {
      "id": "normalized",
      "label": "All model numbers are editable teaching assumptions",
      "value": true,
      "provenance": "assumed-model"
    },
    {
      "id": "circuitIdentity",
      "label": "Separate named circuits never mix stock through heat links",
      "value": true,
      "provenance": "authored-layout"
    }
  ],
  "units": {
    "power": "normalized power units; explicit optional display mapping",
    "flow": "normalized material units per toy minute",
    "inventory": "normalized finite stock",
    "heat": "normalized stored heat; not a physical operating temperature"
  }
