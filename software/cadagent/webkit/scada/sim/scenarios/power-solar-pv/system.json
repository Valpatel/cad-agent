  "provenance": [
    {
      "id": "assumed-model",
      "label": "Editable normalized model guesses",
      "kind": "assumed",
      "description": "Every capacity, inventory, thermal index, loss, response and incident coefficient is an authoring choice, not validated by the references."
    },
    {
      "id": "authored-layout",
      "label": "Illustrative plant routing and layout",
      "kind": "illustrative",
      "description": "Coordinates, asset tags, selected concept composition and simplified connections are editable authored diagrams, not a verified P&ID or electrical design."
    },
    {
      "id": "P18",
      "label": "P18 \u00b7 structural reference",
      "kind": "external",
      "source": "DOE, [Solar Photovoltaic System Design Basics](https://www.energy.gov/cmei/systems/solar-photovoltaic-system-design-basics), updated 2022-07-08",
      "description": "Mounting, inverter and storage sections | Supports: PV DC output, inverter conversion and optional storage are explicit components. Tracking is a visual/configuration variant, not a different generator family. | Reviewed 2026-11-13. Does not validate toy parameters."
    }
  ],
  "assumptions": [
    {
      "id": "normalized",
      "label": "All model numbers are editable teaching assumptions",
      "value": true,
      "provenance": "assumed-model"
    },
    {
      "id": "circuitIdentity",
      "label": "Separate named circuits never mix stock through heat links",
      "value": true,
      "provenance": "authored-layout"
    }
  ],
  "units": {
    "power": "normalized power units; explicit optional display mapping",
    "flow": "normalized material units per toy minute",
    "inventory": "normalized finite stock",
    "heat": "normalized stored heat; not a physical operating temperature"
  }
