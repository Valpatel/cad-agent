graph connectivity {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10];
  node [shape=box, style=rounded, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  subgraph cluster_0 {
    label="static frame"; style=rounded; color=gray60;
    "ball#0" [style="rounded,dashed"];
    "ball#1" [style="rounded,dashed"];
    "ball#2" [style="rounded,dashed"];
    "ball#3" [style="rounded,dashed"];
    "ball#4" [style="rounded,dashed"];
    "ball#5" [style="rounded,dashed"];
    "ball#6" [style="rounded,dashed"];
    "ball#7" [style="rounded,dashed"];
    "base" [peripheries=2];
    "board";
    "bracket";
    "frame";
    "hinge_block";
    "hopper";
    "insert_0";
    "insert_1";
    "insert_2";
    "insert_3";
    "lid";
    "pin";
    "screw_0" [shape=ellipse];
    "screw_1" [shape=ellipse];
    "screw_2" [shape=ellipse];
    "screw_3" [shape=ellipse];
    "stop";
  }
  subgraph cluster_1 {
    label="body arm"; style=rounded; color=gray60;
    "arm";
  }
  "arm" -- "hinge_block" [color=gray60];
  "arm" -- "pin" [color=gray60];
  "arm" -- "stop" [color=gray60];
  "ball#0" -- "ball#4" [color=gray60];
  "ball#0" -- "hopper" [color=gray60];
  "ball#1" -- "ball#5" [color=gray60];
  "ball#1" -- "hopper" [color=gray60];
  "ball#2" -- "ball#6" [color=gray60];
  "ball#2" -- "hopper" [color=gray60];
  "ball#3" -- "ball#7" [color=gray60];
  "ball#3" -- "hopper" [color=gray60];
  "base" -- "bracket";
  "base" -- "frame";
  "base" -- "hinge_block";
  "base" -- "hopper";
  "base" -- "stop";
  "board" -- "hopper";
  "hinge_block" -- "pin";
  "hopper" -- "insert_0";
  "hopper" -- "insert_1";
  "hopper" -- "insert_2";
  "hopper" -- "insert_3";
  "hopper" -- "lid";
  "insert_0" -- "lid";
  "insert_0" -- "screw_0";
  "insert_1" -- "lid";
  "insert_1" -- "screw_1";
  "insert_2" -- "lid";
  "insert_2" -- "screw_2";
  "insert_3" -- "lid";
  "insert_3" -- "screw_3";
  "lid" -- "screw_0";
  "lid" -- "screw_1";
  "lid" -- "screw_2";
  "lid" -- "screw_3";
  "ball#0" -- "hopper" [style=dotted, label="in hopper_cavity"];
  "ball#1" -- "hopper" [style=dotted, label="in hopper_cavity"];
  "ball#2" -- "hopper" [style=dotted, label="in hopper_cavity"];
  "ball#3" -- "hopper" [style=dotted, label="in hopper_cavity"];
  "ball#4" -- "hopper" [style=dotted, label="in hopper_cavity"];
  "ball#5" -- "hopper" [style=dotted, label="in hopper_cavity"];
  "ball#6" -- "hopper" [style=dotted, label="in hopper_cavity"];
  "ball#7" -- "hopper" [style=dotted, label="in hopper_cavity"];
  "arm" -- "pin" [style=dashed, color=blue, label="I-pin-arm revolute"];
}
